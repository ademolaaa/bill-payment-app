# =========================================================================
# KYVATRON: PRODUCTION & STAGING ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local (for local development) or configure inside
# your hosting provider (Vercel / Netlify / AWS) and Supabase dashboards.
# =========================================================================

# -------------------------------------------------------------------------
# Supabase Backend Configuration
# -------------------------------------------------------------------------
# Your Supabase Project API URL (Retrieve from settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co

# Your Supabase Anonymous Client Key (Publicly safe to expose)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (Keep Private - Required for backend admin mutations only)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -------------------------------------------------------------------------
# Flutterwave Gateway Config (NGN Direct Utility Bills & Bank Funding)
# -------------------------------------------------------------------------
# Your Secret Merchant API key (FLWSECK_TEST-... or FLWSECK-...)
FLUTTERWAVE_SECRET_KEY=FLWSECK-your-flutterwave-secret-key-X

# Secret string used to sign and verify incoming Flutterwave webhook payloads
FLUTTERWAVE_WEBHOOK_SECRET=your-custom-flutterwave-webhook-passphrase

# Your Public Merchant API key (FLWPUBK_TEST-... or FLWPUBK-...)
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-your-flutterwave-public-key-X

# -------------------------------------------------------------------------
# NOWPayments Gateway Config (USDT TRC20 Crypto Ingest & Webhooks)
# -------------------------------------------------------------------------
# Your NOWPayments API Merchant Key (Generate from Personal Dashboard -> API keys)
NOWPAYMENTS_API_KEY=your-nowpayments-api-key

# Your NOWPayments Instant Payment Notification (IPN) Signature Verification Secret
# (Generate from NOWPayments -> Account Settings -> IPN Secret)
NOWPAYMENTS_IPN_SECRET=your-nowpayments-ipn-secret
